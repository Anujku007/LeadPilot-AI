# Local credentials - enter your own values in .env
NVIDIA_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PUBLIC_BASE_URL=
# Optional absolute path to persistent Gather SQLite database
LEADPILOT_GATHER_DB=

# NVIDIA AI (fill privately in .env)
NVIDIA_MODEL=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Authentication (HTTPS deployment only; review reverse proxy and cookie settings)
# LP_AUTH_COOKIE_SECURE=true
# LP_AUTH_ORIGINS=https://your-app.example
# Database override (optional, normally defaults to local SQLite)
# LEADPILOT_DATABASE_URL=sqlite:///path/to/private-data.sqlite3
